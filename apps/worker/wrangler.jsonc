// Cloudflare Worker config.
//
// TOP LEVEL = LOCAL DEV / TEST (`pnpm dev`, every integration test). Its ids are all-zero placeholders on purpose:
// Miniflare simulates R2/D1/KV/DO/rate limits locally and Browser Run uses a local Chrome, so no account is needed,
// and a bare `wrangler deploy` (no `--env`) cannot reach real data.
//
// `env.production` = the ONE deployed Worker `wwm` (API + web app as static assets). Its `previews` block holds the
// settings for per-PR Worker Previews (`wrangler preview --env production --name pr-<N>`, Phase 17). Always pass
// `--env production` to deploy/preview/secret/d1 commands. Resource NAMES live in infra/cloudflare.config.json;
// `node infra/scripts/provision.mjs --apply` creates the resources and writes their ids below.
// Guard: `node infra/scripts/check-deploy-config.mjs all` (infra/README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Build jobs run in the BuildJob Durable Object; the builder is CPU-heavy on tall pages (Phase 03), so
  // raise the per-invocation CPU limit (Workers Paid, "standard" usage model; max 300 000 ms).
  "limits": { "cpu_ms": 300000 },

  "vars": {
    // "browser-run" (Cloudflare Browser Run; local Chrome under `wrangler dev`) or "sidecar" (Node capture
    // sidecar at CAPTURE_SIDECAR_URL, see `pnpm --filter @wwm/worker capture-sidecar`).
    "CAPTURE_BACKEND": "browser-run",
    "CAPTURE_SIDECAR_URL": "",
    // DEV/TEST ONLY: comma-separated loopback host:port pairs exempt from the SSRF IP/port rules. Must stay
    // empty in production (non-loopback entries are ignored anyway).
    "DEV_ALLOWED_HOSTS": "",
    "DOH_URL": "https://cloudflare-dns.com/dns-query",
    "BUILD_LIMIT_PER_HOUR": "10",
    "BROWSER_MAX_CONCURRENCY": "2",
    "CAPTURE_BUDGET_MS": "20000",
    "SLICE0_BUDGET_MS": "30000",
    "CACHE_TTL_DAYS": "7",
    "RETENTION_DAYS": "30",
    // Phase 12: all new builds per hour across all clients.
    "GLOBAL_BUILD_LIMIT_PER_HOUR": "600",
    // Phase 12 kill switch: "0" refuses new captures (cached runs and curated stages still play). The runtime
    // switch without a redeploy is the KV key `kill:capture` (docs/launch/runbook.md).
    "CAPTURE_ENABLED": "1",
    // "development" | "preview" | "production". Any value other than "development" is a deployed environment
    // and fails closed on missing secrets.
    "WWM_ENV": "development",
    // Phase 12 (contracts v0.2.3): "1" exposes GET /api/rooms/:code/stats. Dev/test ONLY; "0" when deployed.
    "ROOM_STATS": "1",
    // Phase 12: "1" accepts client telemetry at POST /api/t (logged, never stored). Off until the user approves.
    "TELEMETRY_INGEST": "0",
    // Phase 15 docent (Cloudflare AI Gateway → Anthropic). Empty here = the deterministic mock provider.
    "AI_GATEWAY_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "",
    "DOCENT_DAILY_LIMIT": "200",
    "DOCENT_PROVIDER": "auto",
    "DOCENT_MODEL": "claude-haiku-4-5",
    "DOCENT_MAX_TOKENS": "600",
    "DOCENT_LIMIT_PER_HOUR": "20",
    "DOCENT_CACHE_TTL_DAYS": "7",
    "DOCENT_MOCK_DELAY_MS": "25"
    // Secrets (not vars): IP_HASH_SALT, ANTHROPIC_API_KEY. Locally: apps/worker/.dev.vars (see .dev.vars.example).
  },

  // Stage JSON, slice textures and capture bundles.
  "r2_buckets": [{ "binding": "STAGES", "bucket_name": "wwm-stages" }],

  // Runs, stages metadata (this phase); scores and curated (Phase 10).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Run cache (`run:<normUrl>:<difficulty>:<builderVersion>`), in-flight job dedupe, opt-out list.
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],

  // Browser Run (headless Chromium) for captures.
  "browser": { "binding": "BROWSER" },

  // Read rate limit: 100 requests / minute / IP (the binding supports 10 s or 60 s periods only; the
  // 10 builds / hour limit uses the Limiter Durable Object instead).
  // Phase 12: room creation 30 / minute / IP, WebSocket upgrades 120 / minute / IP (reconnects included).
  // namespace_id scheme (unique per account): 70xx local, 71xx retired (old staging), 72xx production, 73xx previews.
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "7001", "simple": { "limit": 100, "period": 60 } },
    { "name": "ROOM_CREATE_LIMITER", "namespace_id": "7002", "simple": { "limit": 30, "period": 60 } },
    { "name": "ROOM_WS_LIMITER", "namespace_id": "7003", "simple": { "limit": 120, "period": 60 } }
  ],

  "durable_objects": {
    "bindings": [
      // One per 6-digit room: WebSocket relay between host and phone (Phase 06, src/room.ts).
      { "name": "ROOM", "class_name": "Room" },
      // One per build job: runs capture → build → store and serves the SSE progress stream.
      { "name": "BUILD_JOB", "class_name": "BuildJob" },
      // Sliding-window counters (per-IP build limit) and the global browser-session semaphore.
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["BuildJob", "Limiter"] }
  ],
  // Retention sweep (task 9): daily at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },

  // ── Deploy target (Phase 12 → Phase 17). Named-environment keys are NOT inherited from the top level, so every
  // var and binding is redeclared. Deploys: .github/workflows/deploy.yml (main) and preview.yml (PRs).
  "env": {
    "production": {
      "name": "wwm",
      // Custom domain (HTTPS on your own domain; iOS only grants motion sensors on secure origins). Filled in by
      // provision.mjs from infra/cloudflare.config.json "domain":
      // [{ "pattern": "<domain>", "custom_domain": true }]. Needs the "Workers Routes: Edit" zone permission once.
      "routes": [{ "pattern": "wwm.ewj.dev", "custom_domain": true }],
      "workers_dev": false,
      // Required for Preview URLs on workers.dev: pr-<N>-wwm.<account-subdomain>.workers.dev (HTTPS).
      "preview_urls": true,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "limits": { "cpu_ms": 300000 },
      // Web app. `assets` stays here (not in `previews`): each Preview uploads the assets of its own branch.
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/s/*"]
      },
      "vars": {
        "CAPTURE_BACKEND": "browser-run",
        "CAPTURE_SIDECAR_URL": "",
        "DEV_ALLOWED_HOSTS": "",
        "DOH_URL": "https://cloudflare-dns.com/dns-query",
        "WWM_ENV": "production",
        "BUILD_LIMIT_PER_HOUR": "10",
        "GLOBAL_BUILD_LIMIT_PER_HOUR": "600",
        "BROWSER_MAX_CONCURRENCY": "2",
        "CAPTURE_BUDGET_MS": "20000",
        "SLICE0_BUDGET_MS": "30000",
        "CACHE_TTL_DAYS": "7",
        "RETENTION_DAYS": "30",
        "CAPTURE_ENABLED": "1",
        "ROOM_STATS": "0",
        "TELEMETRY_INGEST": "0",
        "AI_GATEWAY_ACCOUNT_ID": "927320d088a7c2ec3c070b43da0e85de",
        "AI_GATEWAY_ID": "wwm",
        "DOCENT_DAILY_LIMIT": "500",
        "DOCENT_PROVIDER": "auto",
        "DOCENT_MODEL": "claude-haiku-4-5",
        "DOCENT_MAX_TOKENS": "600",
        "DOCENT_LIMIT_PER_HOUR": "20",
        "DOCENT_CACHE_TTL_DAYS": "7",
        "DOCENT_MOCK_DELAY_MS": "0"
      },
      "r2_buckets": [{ "binding": "STAGES", "bucket_name": "wwm-stages" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wwm",
          "database_id": "68d408cd-47b7-4313-a361-09fbe3996a35",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "fcf10fbc42ef404391736d38c6117739" }],
      "browser": { "binding": "BROWSER" },
      "ratelimits": [
        { "name": "READ_LIMITER", "namespace_id": "7201", "simple": { "limit": 100, "period": 60 } },
        { "name": "ROOM_CREATE_LIMITER", "namespace_id": "7202", "simple": { "limit": 30, "period": 60 } },
        { "name": "ROOM_WS_LIMITER", "namespace_id": "7203", "simple": { "limit": 120, "period": 60 } }
      ],
      // Durable Object classes and migrations stay here; every Preview automatically gets its own DO namespaces
      // and storage (rooms, build jobs and limiter counters never mix with production).
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "BUILD_JOB", "class_name": "BuildJob" },
          { "name": "LIMITER", "class_name": "Limiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Room"] },
        { "tag": "v2", "new_sqlite_classes": ["BuildJob", "Limiter"] }
      ],
      // Cron Triggers only run on production (never on Previews).
      "triggers": { "crons": ["17 3 * * *"] },

      // ── Worker Previews (one per PR). Previews inherit NOTHING from production: every var and every binding the
      // code reads from `env` is repeated here, pointed at preview-only resources. No crons/routes/queue consumers
      // here (they don't apply to Previews). Preview D1 migrations: wrangler.preview-migrations.jsonc (same db).
      // Preview secrets: `wrangler preview base-config secret put <NAME> --env production` (infra/README.md).
      "previews": {
        "observability": { "enabled": true, "head_sampling_rate": 1 },
        "limits": { "cpu_ms": 300000 },
        "vars": {
          "CAPTURE_BACKEND": "browser-run",
          "CAPTURE_SIDECAR_URL": "",
          "DEV_ALLOWED_HOSTS": "",
          "DOH_URL": "https://cloudflare-dns.com/dns-query",
          "WWM_ENV": "preview",
          "BUILD_LIMIT_PER_HOUR": "10",
          // Lower caps: Previews share the account's Browser Run concurrency with production.
          "GLOBAL_BUILD_LIMIT_PER_HOUR": "60",
          "BROWSER_MAX_CONCURRENCY": "1",
          "CAPTURE_BUDGET_MS": "20000",
          "SLICE0_BUDGET_MS": "30000",
          "CACHE_TTL_DAYS": "1",
          "RETENTION_DAYS": "7",
          "CAPTURE_ENABLED": "1",
          "ROOM_STATS": "0",
          "TELEMETRY_INGEST": "0",
          "AI_GATEWAY_ACCOUNT_ID": "927320d088a7c2ec3c070b43da0e85de",
          "AI_GATEWAY_ID": "wwm-preview",
          "DOCENT_DAILY_LIMIT": "50",
          "DOCENT_PROVIDER": "auto",
          "DOCENT_MODEL": "claude-haiku-4-5",
          "DOCENT_MAX_TOKENS": "600",
          "DOCENT_LIMIT_PER_HOUR": "20",
          "DOCENT_CACHE_TTL_DAYS": "7",
          "DOCENT_MOCK_DELAY_MS": "0"
        },
        "r2_buckets": [{ "binding": "STAGES", "bucket_name": "wwm-stages-preview" }],
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "wwm-preview",
            "database_id": "fd5ce3d4-5df4-442c-97fd-50e266ecd7a5",
            "migrations_dir": "migrations"
          }
        ],
        "kv_namespaces": [{ "binding": "CACHE", "id": "dae2b404a2df454cae5b348f46860a4f" }],
        "browser": { "binding": "BROWSER" },
        "ratelimits": [
          { "name": "READ_LIMITER", "namespace_id": "7301", "simple": { "limit": 100, "period": 60 } },
          { "name": "ROOM_CREATE_LIMITER", "namespace_id": "7302", "simple": { "limit": 30, "period": 60 } },
          { "name": "ROOM_WS_LIMITER", "namespace_id": "7303", "simple": { "limit": 120, "period": 60 } }
        ],
        // Bindings only (the code reads env.ROOM etc.); classes/migrations come from above, storage is per Preview.
        "durable_objects": {
          "bindings": [
            { "name": "ROOM", "class_name": "Room" },
            { "name": "BUILD_JOB", "class_name": "BuildJob" },
            { "name": "LIMITER", "class_name": "Limiter" }
          ]
        }
      }
    }
  }
}
