// Cloudflare Worker config. All resource IDs below are PLACEHOLDERS: no Cloudflare resources exist yet.
// Phase 07/12 create the real R2 bucket, D1 database and KV namespace and replace the IDs before deploying.
// Local `wrangler dev` simulates R2/D1/KV/DO with Miniflare, so placeholders are fine for development.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Stage JSON + textures (Phase 07).
  "r2_buckets": [{ "binding": "STAGES", "bucket_name": "wwm-stages" }],

  // Scores, jobs, stage metadata (Phase 07).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // URL → stageId cache (Phase 07).
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],

  // Browser Rendering (headless Chromium) for captures (Phase 07). Needs `remote: true` or a deployed
  // Worker to actually launch a browser; the binding is declared so types and routing exist now.
  "browser": { "binding": "BROWSER" },

  // One Durable Object per 6-digit room: WebSocket relay between host and phone (Phase 06, src/room.ts).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
