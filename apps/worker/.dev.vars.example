# Copy to .dev.vars for local secrets (gitignored). Deployed: `wrangler secret put IP_HASH_SALT --env production` and
# `wrangler preview base-config secret put IP_HASH_SALT --env production` (Previews); see infra/README.md.
# Without it the Worker uses a built-in dev default and logs a warning.
IP_HASH_SALT=change-me-to-32-random-characters

# Phase 15 AI docent (optional; without these `pnpm dev` uses the offline mock). Real answers through Cloudflare
# AI Gateway need both gateway ids and at least one of the two secrets. See infra/README.md "AI docent".
# AI_GATEWAY_ACCOUNT_ID=your-cloudflare-account-id
# AI_GATEWAY_ID=wwm-docent
# ANTHROPIC_API_KEY=sk-ant-...
# AI_GATEWAY_TOKEN=...   # authenticated gateway (cf-aig-authorization); alone = keys stored in the gateway (BYOK)

# Phase 31 learning accounts (optional locally). Without TURNSTILE_SECRET, `pnpm dev` uses Cloudflare's always-pass
# test secret, and sign-in links go to the mock mailbox (GET /api/learning/dev/mailbox?to=<email>).
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# LEARNING_ALLOWED_EMAILS=you@example.org,other@example.org   # read only when LEARNING_ACCOUNTS=allowlist
