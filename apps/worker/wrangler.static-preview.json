{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wwm-preview-manual-mobile-tilt",
  "main": "src/static-preview.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 10 },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
