+    const tier = l.tier;
+    run(l, 60, 4);
+    l.suspend();
+    expect(l.fps).toBe(0);
+    expect(l.status).toBe('suspended');
+    run(l, 60, 5);
+    expect(l.tier).toBe(tier);
