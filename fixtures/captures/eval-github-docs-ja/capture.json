    {"id":82,"kind":"text","rect":{"x":443,"y":635.34,"w":720,"h":76.78},"lines":[{"x":443,"y":636.34,"w":715.2,"h":22},{"x":443,"y":661.94,"w":716.73,"h":22},{"x":443,"y":687.53,"w":301.13,"h":22}],"depth":14,"z":0,"fixed":false,"text":"ソフトウェア開発ライフサイクルでは、最初のアイデアから運用環境でのコードの実行まで、ソフトウェア プロジェクトが進むステージについて説明します。 GitHub は、そのプロセスのすべての段階をサポートするように設計されています。","fontSize":16},
    {"id":83,"kind":"text","rect":{"x":443,"y":728.13,"w":720,"h":179.16},"lines":[{"x":443,"y":729.13,"w":708.7,"h":22},{"x":443,"y":754.72,"w":718.95,"h":22},{"x":443,"y":780.31,"w":705,"h":22},{"x":443,"y":805.91,"w":712.98,"h":22},{"x":443,"y":831.5,"w":715.17,"h":22},{"x":443,"y":857.09,"w":715.38,"h":22},{"x":443,"y":882.69,"w":262.17,"h":22}],"depth":14,"z":0,"fixed":false,"text":"| 段階 | GitHub でできること | |---|---| | Plan | 作業を追跡し、マイルストーンを設定し、長期的なプロジェクトを整理します。 | | Create | コードを記述して保存し、新しい機能を安全に開発し、変更…","fontSize":16},
    {"id":84,"kind":"text","rect":{"x":443,"y":923.28,"w":720,"h":51.19},"lines":[{"x":443,"y":924.28,"w":704.67,"h":22},{"x":443,"y":949.88,"w":586.56,"h":22}],"depth":14,"z":0,"fixed":false,"text":"すべてのステージを一度に使用する必要はありません。 多くの人がリポジトリといくつかの問題から始めて、プロジェクトの拡大に合わせてプラットフォームの使用を拡大します。","fontSize":16},
    {"id":85,"kind":"heading","rect":{"x":443,"y":1030.47,"w":720,"h":54.38},"lines":[{"x":443,"y":1044.47,"w":150.34,"h":34}],"depth":14,"z":0,"fixed":false,"text":"GitHub と Git","fontSize":24},
    {"id":86,"kind":"link","rect":{"x":443,"y":1044.47,"w":174.34,"h":34},"depth":15,"z":0,"fixed":false,"text":"GitHub と Git","fontSize":24},
    {"id":87,"kind":"block","rect":{"x":601.34,"y":1054.47,"w":16,"h":16},"bg":"#58635b","depth":16,"z":0,"fixed":false},
    {"id":88,"kind":"text","rect":{"x":443,"y":1100.84,"w":720,"h":25.59},"lines":[{"x":443,"y":1101.84,"w":517.22,"h":22}],"depth":14,"z":0,"fixed":false,"text":"GitHub は、オープンソース ソフトウェアである Git に基づいています。","fontSize":16},
    {"id":89,"kind":"text","rect":{"x":443,"y":1142.44,"w":720,"h":51.19},"lines":[{"x":443,"y":1143.44,"w":713.66,"h":22},{"x":443,"y":1169.03,"w":700.81,"h":22}],"depth":14,"z":0,"fixed":false,"text":"Git は、ファイルへの変更を追跡するバージョン 管理システムです。 プロジェクトの独自のコピーで作業し、変更履歴を記録し、作業内容を他のユーザーの変更と安全にマージすることができます。","fontSize":16},
    {"id":90,"kind":"text","rect":{"x":443,"y":1209.63,"w":720,"h":51.19},"lines":[{"x":443,"y":1210.63,"w":713.88,"h":22},{"x":443,"y":1236.22,"w":634.91,"h":22}],"depth":14,"z":0,"fixed":false,"text":"GitHub は、 リポジトリと呼 ばれる Git プロジェクトをクラウドでホストし、チームの共同作業を容易にする計画およびコラボレーション ツールを追加することで、Git 上に構築されます。","fontSize":16},
    {"id":91,"kind":"text","rect":{"x":443,"y":1276.81,"w":720,"h":25.59},"lines":[{"x":443,"y":1277.81,"w":445.33,"h":22}],"depth":14,"z":0,"fixed":false,"text":"Git の詳細については、「 Git について 」を参照してください。","fontSize":16},
    {"id":92,"kind":"link","rect":{"x":624.31,"y":1277.81,"w":89.45,"h":22},"depth":15,"z":0,"fixed":false,"text":"Git について","fontSize":16},
    {"id":93,"kind":"heading","rect":{"x":443,"y":1358.41,"w":720,"h":54.38},"lines":[{"x":443,"y":1372.41,"w":333.44,"h":34}],"depth":14,"z":0,"fixed":false,"text":"GitHubは私に適していますか?","fontSize":24},
    {"id":94,"kind":"link","rect":{"x":443,"y":1372.41,"w":357.44,"h":34},"depth":15,"z":0,"fixed":false,"text":"GitHubは私に適していますか?","fontSize":24},
    {"id":95,"kind":"block","rect":{"x":784.44,"y":1382.41,"w":16,"h":16},"bg":"#58635b","depth":16,"z":0,"fixed":false},
    {"id":96,"kind":"text","rect":{"x":443,"y":1428.78,"w":720,"h":51.19},"lines":[{"x":443,"y":1429.78,"w":705.55,"h":22},{"x":443,"y":1455.38,"w":619.38,"h":22}],"depth":14,"z":0,"fixed":false,"text":"GitHub は、学生、開発者、プロジェクト マネージャー、セキュリティ チーム、データ サイエンティスト、研究者、人事、法務スタッフなど、あらゆる規模の組織で使用されています。","fontSize":16},
    {"id":97,"kind":"text","rect":{"x":443,"y":1495.97,"w":720,"h":25.59},"lines":[{"x":443,"y":1496.97,"w":404.05,"h":22}],"depth":14,"z":0,"fixed":false,"text":"GitHubを使用する最も一般的な理由は次のとおりです。","fontSize":16},
    {"id":98,"kind":"text","rect":{"x":475,"y":1537.56,"w":688,"h":25.59},"lines":[{"x":475,"y":1538.56,"w":432.03,"h":22}],"depth":15,"z":0,"fixed":false,"text":"バージョン 管理を使用してコードを格納および管理します。","fontSize":16},
    {"id":99,"kind":"text","rect":{"x":475,"y":1571.16,"w":688,"h":25.59},"lines":[{"x":475,"y":1572.16,"w":653.13,"h":22}],"depth":15,"z":0,"fixed":false,"text":"コードを記述し、コードを確認し、セキュリティの脆弱性と更新プログラムを管理します。","fontSize":16},
    {"id":100,"kind":"text","rect":{"x":475,"y":1604.75,"w":688,"h":25.59},"lines":[{"x":475,"y":1605.75,"w":380.97,"h":22}],"depth":15,"z":0,"fixed":false,"text":"プロジェクトで共同作業とソーシャル化を行います。","fontSize":16},
    {"id":101,"kind":"text","rect":{"x":475,"y":1638.34,"w":688,"h":25.59},"lines":[{"x":475,"y":1639.34,"w":314.56,"h":22}],"depth":15,"z":0,"fixed":false,"text":"オープンソースソフトウェアに貢献します。","fontSize":16},
    {"id":102,"kind":"text","rect":{"x":475,"y":1671.94,"w":688,"h":25.59},"lines":[{"x":475,"y":1672.94,"w":285.77,"h":22}],"depth":15,"z":0,"fixed":false,"text":"プロジェクトを追跡および管理します。","fontSize":16},
    {"id":103,"kind":"text","rect":{"x":475,"y":1705.53,"w":688,"h":25.59},"lines":[{"x":475,"y":1706.53,"w":587.69,"h":22}],"depth":15,"z":0,"fixed":false,"text":"CI/CD、テスト、デプロイなどのソフトウェア開発ワークフローを自動化します。","fontSize":16},
    {"id":104,"kind":"text","rect":{"x":475,"y":1739.13,"w":688,"h":25.59},"lines":[{"x":475,"y":1740.13,"w":205.45,"h":22}],"depth":15,"z":0,"fixed":false,"text":"作業を紹介して共有します。","fontSize":16},
    {"id":105,"kind":"text","rect":{"x":475,"y":1772.72,"w":688,"h":25.59},"lines":[{"x":475,"y":1773.72,"w":383.55,"h":22}],"depth":15,"z":0,"fixed":false,"text":"ソフトウェア パッケージを発行してリリースします。","fontSize":16},
    {"id":106,"kind":"text","rect":{"x":475,"y":1806.31,"w":688,"h":25.59},"lines":[{"x":475,"y":1807.31,"w":327.61,"h":22}],"depth":15,"z":0,"fixed":false,"text":"ドキュメントと Web サイトをホストします。","fontSize":16},
    {"id":107,"kind":"text","rect":{"x":475,"y":1839.91,"w":688,"h":25.59},"lines":[{"x":475,"y":1840.91,"w":474.56,"h":22}],"depth":15,"z":0,"fixed":false,"text":"ソフトウェア開発コミュニティやディスカッションに参加します。","fontSize":16},
    {"id":108,"kind":"text","rect":{"x":475,"y":1873.5,"w":688,"h":51.19},"lines":[{"x":475,"y":1874.5,"w":687.86,"h":22},{"x":475,"y":1900.09,"w":206.41,"h":22}],"depth":15,"z":0,"fixed":false,"text":"AI を利用したツールとエージェントを使用して、コード開発の記述、理解、レビュー、自動化を迅速に行うことができます。","fontSize":16},
    {"id":109,"kind":"heading","rect":{"x":443,"y":1980.69,"w":720,"h":54.38},"lines":[{"x":443,"y":1994.69,"w":192,"h":34}],"depth":14,"z":0,"fixed":false,"text":"どこから始めるか","fontSize":24},
    {"id":110,"kind":"link","rect":{"x":443,"y":1994.69,"w":216,"h":34},"depth":15,"z":0,"fixed":false,"text":"どこから始めるか","fontSize":24},
    {"id":111,"kind":"block","rect":{"x":643,"y":2004.69,"w":16,"h":16},"bg":"#58635b","depth":16,"z":0,"fixed":false},
    {"id":112,"kind":"text","rect":{"x":443,"y":2051.06,"w":720,"h":76.78},"lines":[{"x":443,"y":2052.06,"w":704.09,"h":22},{"x":443,"y":2077.66,"w":714.8,"h":22},{"x":443,"y":2103.25,"w":380.17,"h":22}],"depth":14,"z":0,"fixed":false,"text":"GitHubが初めてで、Git に慣れていない場合は、 体験してみる カテゴリの記事を参照することをお勧めします。 この記事では、ソフトウェア開発者が GitHubを使用して実行する一般的なタスクを実行する方法について説明します。次に例を…","fontSize":16},
    {"id":113,"kind":"link","rect":{"x":792.66,"y":2052.06,"w":95.05,"h":22},"depth":15,"z":0,"fixed":false,"text":"体験してみる","fontSize":16},
    {"id":114,"kind":"text","rect":{"x":475,"y":2143.84,"w":688,"h":51.19},"lines":[{"x":475,"y":2144.84,"w":680.52,"h":22},{"x":475,"y":2170.44,"w":417.8,"h":22}],"depth":15,"z":0,"fixed":false,"text":"ソフトウェア プロジェクトのリポジトリを作成 し、 GitHubにコードを保存します。 GitHubでのプロジェクトのリポジトリの作成 を参照してください。","fontSize":16},
    {"id":115,"kind":"link","rect":{"x":475,"y":2144.84,"w":680.52,"h":47.59},"depth":16,"z":0,"fixed":false,"text":"GitHubでのプロジェクトのリポジトリの作成","fontSize":16},
    {"id":116,"kind":"text","rect":{"x":475,"y":2203.03,"w":688,"h":25.59},"lines":[{"x":475,"y":2204.03,"w":492.17,"h":22}],"depth":15,"z":0,"fixed":false,"text":"問題を作成し、プロジェクトの作業を追跡して、作業を 計画 します。","fontSize":16},
    {"id":117,"kind":"text","rect":{"x":475,"y":2236.63,"w":688,"h":51.19},"lines":[{"x":475,"y":2237.63,"w":678.91,"h":22},{"x":475,"y":2263.22,"w":248.5,"h":22}],"depth":15,"z":0,"fixed":false,"text":"ローカル コンピューター上のコードに接続 し、 GitHub Desktop アプリケーションを使用して Git でコードの変更を管理します。","fontSize":16},
    {"id":118,"kind":"text","rect":{"x":475,"y":2295.81,"w":688,"h":51.19},"lines":[{"x":475,"y":2296.81,"w":687.3,"h":22},{"x":475,"y":2322.41,"w":62.41,"h":22}],"depth":15,"z":0,"fixed":false,"text":"コードを記述して保存し 、必要に応じて AI アシスタントとペアリングし、変更を GitHubと同期します。","fontSize":16},
    {"id":119,"kind":"text","rect":{"x":475,"y":2355,"w":688,"h":51.19},"lines":[{"x":475,"y":2356,"w":673.95,"h":22},{"x":475,"y":2381.59,"w":126.41,"h":22}],"depth":15,"z":0,"fixed":false,"text":"提案したコード変更をレビュー するには、マージする前にプル リクエストを作成し、自分の変更を確認します。","fontSize":16},
    {"id":120,"kind":"text","rect":{"x":475,"y":2414.19,"w":688,"h":51.19},"lines":[{"x":475,"y":2415.19,"w":684.56,"h":22},{"x":475,"y":2440.78,"w":279.61,"h":22}],"depth":15,"z":0,"fixed":false,"text":"自動展開ワークフローを使用して Web サイトを デプロイすると、ソフトウェア プロジェクトの基本的な Web サイトを発行できます。","fontSize":16},
